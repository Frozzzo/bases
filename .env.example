# Opcional. Sin estas variables el juego usa memoria del servidor (sirve en local o con una sola instancia).
# Vercel KV / Upstash Redis (Vercel Marketplace -> Upstash for Redis) define estas automáticamente:
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Alternativa equivalente si creas la base directamente en upstash.com:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
